---
type ReviewExplorerItem = {
  slug: string;
  title: string;
  author?: string;
  href: string;
  image?: string;
  readerWorry?: string;
  tags: string[];
};

interface Props {
  items: ReviewExplorerItem[];
  initialLimit?: number;
}

const { items, initialLimit = 8 } = Astro.props;
const initialItems = items.slice(0, initialLimit);
const situations = [...new Set(items.flatMap((item) => item.tags))].sort((a, b) => a.localeCompare(b, "ja"));
const payload = JSON.stringify(items)
  .replace(/</g, "\\u003C")
  .replace(/>/g, "\\u003E")
  .replace(/&/g, "\\u0026");
---

<section class="review-explorer" data-review-explorer data-page-size={initialLimit}>
  <form class="review-controls" role="search" aria-label="レビューを探す">
    <label>
      <span>キーワード</span>
      <input type="search" name="q" autocomplete="off" placeholder="書名、著者から探す" aria-label="レビューを検索" />
    </label>
    <label>
      <span>テーマ</span>
      <select name="situation" aria-label="テーマで絞り込む">
        <option value="">すべてのテーマ</option>
        {situations.map((situation) => <option value={situation}>{situation}</option>)}
      </select>
    </label>
    <button type="submit">探す</button>
    <button type="reset">条件を戻す</button>
  </form>

  <p class="review-results" aria-live="polite" data-review-results>
    {items.length}冊のうち{Math.min(initialLimit, items.length)}冊を表示
  </p>

  <ol class="review-list" data-review-list>
    {initialItems.map((item, index) => (
      <li class="review-item" data-review-slug={item.slug}>
        <span class="review-order" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        {item.image && (
          <a class="review-media" href={item.href} tabindex="-1" aria-hidden="true">
            <img src={item.image} alt="" loading="lazy" decoding="async" width="180" height="220" />
          </a>
        )}
        <div class="review-copy">
          {item.tags.length > 0 && <p class="review-tags">{item.tags.slice(0, 2).join(" / ")}</p>}
          <h3><a href={item.href}>{item.title}</a></h3>
          {item.author && <p class="review-author">著者: {item.author}</p>}
          {item.readerWorry && <p class="review-worry"><strong>こんなモヤモヤに</strong>{item.readerWorry}</p>}
          <a class="review-link" href={item.href}>レビューを読む</a>
        </div>
      </li>
    ))}
  </ol>

  <div class="review-more-wrap" data-review-more-wrap hidden={items.length <= initialLimit}>
    <button class="review-more" type="button" data-review-more>さらにレビューを読む</button>
  </div>

  <div class="review-empty" data-review-empty hidden>
    <h3>近い入口が見つかりませんでした。</h3>
    <p>キーワードやテーマを変えて、もう一度探してみてください。</p>
  </div>
</section>

<script is:inline type="application/json" data-review-payload set:html={payload}></script>

<script>
  type Item = {
    slug: string;
    title: string;
    author?: string;
    href: string;
    image?: string;
    readerWorry?: string;
    tags: string[];
  };

  const root = document.querySelector<HTMLElement>("[data-review-explorer]");
  const payloadNode = document.querySelector<HTMLScriptElement>("[data-review-payload]");
  const form = root?.querySelector<HTMLFormElement>("form");
  const list = root?.querySelector<HTMLOListElement>("[data-review-list]");
  const results = root?.querySelector<HTMLElement>("[data-review-results]");
  const more = root?.querySelector<HTMLButtonElement>("[data-review-more]");
  const moreWrap = root?.querySelector<HTMLElement>("[data-review-more-wrap]");
  const empty = root?.querySelector<HTMLElement>("[data-review-empty]");

  if (root && payloadNode && form && list && results && more && moreWrap && empty) {
    const allItems = JSON.parse(payloadNode.textContent || "[]") as Item[];
    const pageSize = Number(root.dataset.pageSize || 8);
    let visibleCount = pageSize;
    const text = (tag: string, value: string, className?: string) => {
      const node = document.createElement(tag);
      node.textContent = value;
      if (className) node.className = className;
      return node;
    };

    const createItem = (item: Item, index: number) => {
      const li = document.createElement("li");
      li.className = "review-item";
      li.dataset.reviewSlug = item.slug;
      li.append(text("span", String(index + 1).padStart(2, "0"), "review-order"));
      if (item.image) {
        const media = document.createElement("a");
        media.className = "review-media";
        media.href = item.href;
        media.tabIndex = -1;
        media.setAttribute("aria-hidden", "true");
        const image = document.createElement("img");
        image.src = item.image;
        image.alt = "";
        image.loading = "lazy";
        image.decoding = "async";
        image.width = 180;
        image.height = 220;
        media.append(image);
        li.append(media);
      }
      const copy = document.createElement("div");
      copy.className = "review-copy";
      if (item.tags.length > 0) copy.append(text("p", item.tags.slice(0, 2).join(" / "), "review-tags"));
      const heading = document.createElement("h3");
      const titleLink = document.createElement("a");
      titleLink.href = item.href;
      titleLink.textContent = item.title;
      heading.append(titleLink);
      copy.append(heading);
      if (item.author) copy.append(text("p", `著者: ${item.author}`, "review-author"));
      if (item.readerWorry) {
        const worry = text("p", "", "review-worry");
        worry.append(text("strong", "こんなモヤモヤに"), document.createTextNode(item.readerWorry));
        copy.append(worry);
      }
      const link = text("a", "レビューを読む", "review-link") as HTMLAnchorElement;
      link.href = item.href;
      copy.append(link);
      li.append(copy);
      return li;
    };

    const readState = () => {
      const params = new URLSearchParams(location.search);
      const q = params.get("q") ?? "";
      const situation = params.get("situation") ?? "";
      const page = Math.max(1, Number(params.get("page") ?? 1));
      const search = form.elements.namedItem("q") as HTMLInputElement;
      const select = form.elements.namedItem("situation") as HTMLSelectElement;
      search.value = q;
      select.value = situation;
      visibleCount = page * pageSize;
      return { q, situation };
    };

    const render = () => {
      const { q, situation } = readState();
      const needle = q.trim().toLocaleLowerCase("ja");
      const filtered = allItems.filter((item) => {
        const haystack = [item.title, item.author, item.readerWorry, ...item.tags]
          .filter(Boolean)
          .join(" ")
          .toLocaleLowerCase("ja");
        return (!needle || haystack.includes(needle)) && (!situation || item.tags.includes(situation));
      });
      const shown = filtered.slice(0, visibleCount);
      list.replaceChildren(...shown.map(createItem));
      results.textContent = `${filtered.length}冊のうち${shown.length}冊を表示`;
      empty.hidden = filtered.length > 0;
      moreWrap.hidden = shown.length >= filtered.length;
    };

    const writeState = (page = 1) => {
      const data = new FormData(form);
      const params = new URLSearchParams();
      const q = String(data.get("q") ?? "").trim();
      const situation = String(data.get("situation") ?? "");
      if (q) params.set("q", q);
      if (situation) params.set("situation", situation);
      if (page > 1) params.set("page", String(page));
      history.pushState(null, "", `${location.pathname}${params.size ? `?${params}` : ""}`);
      render();
    };

    form.addEventListener("submit", (event) => { event.preventDefault(); writeState(1); });
    form.addEventListener("reset", () => requestAnimationFrame(() => writeState(1)));
    more.addEventListener("click", () => writeState(Math.floor(visibleCount / pageSize) + 1));
    addEventListener("popstate", render);
    render();
  }
</script>

<style is:global>
  [data-review-explorer] {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  [data-review-explorer] .review-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr) auto auto;
    gap: 0.65rem;
    align-items: end;
    min-width: 0;
  }

  [data-review-explorer] .review-controls label {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  [data-review-explorer] :is(.review-controls input, .review-controls select, .review-controls button, .review-more) {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0 0.8rem;
    background: rgba(255, 255, 255, 0.82);
    color: var(--color-text);
    font: inherit;
  }

  [data-review-explorer] :is(.review-controls button, .review-more) {
    width: auto;
    cursor: pointer;
    font-weight: 700;
    white-space: nowrap;
  }

  [data-review-explorer] .review-results {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-caption);
  }

  [data-review-explorer] .review-list {
    display: grid;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-review-explorer] .review-item {
    display: grid;
    grid-template-columns: 2.25rem 7rem minmax(0, 1fr);
    gap: clamp(0.8rem, 2vw, 1.25rem);
    align-items: start;
    min-width: 0;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }

  [data-review-explorer] .review-order {
    padding-top: 0.2rem;
    color: color-mix(in srgb, var(--color-accent) 65%, transparent);
    font-family: var(--font-headline);
    font-size: 1.05rem;
  }

  [data-review-explorer] .review-media {
    display: block;
    overflow: hidden;
    min-width: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
  }

  [data-review-explorer] .review-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-review-explorer] .review-copy {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  [data-review-explorer] .review-copy :is(h3, p) {
    min-width: 0;
    margin: 0;
  }

  [data-review-explorer] .review-tags {
    color: var(--color-accent);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  [data-review-explorer] .review-copy h3 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.3;
  }

  [data-review-explorer] .review-copy h3 a:hover,
  [data-review-explorer] .review-link:hover {
    color: var(--color-accent);
  }

  [data-review-explorer] .review-author {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  [data-review-explorer] .review-worry {
    display: grid;
    gap: 0.12rem;
    max-width: var(--measure-copy);
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  [data-review-explorer] .review-worry strong {
    color: var(--color-accent);
    font-size: var(--text-caption);
  }

  [data-review-explorer] .review-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    margin-top: 0.15rem;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  [data-review-explorer] .review-more-wrap { text-align: center; }

  [data-review-explorer] .review-more { padding-inline: 1.25rem; }

  [data-review-explorer] .review-empty {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  [data-review-explorer] .review-empty :is(h3, p) { margin: 0; }

  [data-review-explorer] .review-empty p {
    margin-top: 0.35rem;
    color: var(--color-muted);
  }

  @media (max-width: 780px) {
    [data-review-explorer] .review-controls {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    [data-review-explorer] .review-controls button { width: 100%; }
  }

  @media (max-width: 560px) {
    [data-review-explorer] .review-controls { grid-template-columns: minmax(0, 1fr); }

    [data-review-explorer] .review-item {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      gap: 0.75rem;
      padding-block: 1rem;
    }

    [data-review-explorer] .review-order { display: none; }
    [data-review-explorer] .review-copy { gap: 0.4rem; }
    [data-review-explorer] .review-copy h3 { font-size: 1.16rem; }
    [data-review-explorer] .review-worry { line-height: 1.58; }
  }
</style>
