---
import SeoHead from '../components/SeoHead.astro';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = '読書 with Coco - 書評とギャラリーを中心に、読後の余韻を静かにひらく読書サイト',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = 'website',
  jsonLd,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site!).toString();
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const navItems = [
  { href: '', label: 'ホーム' },
  { href: 'reviews/', label: 'レビュー' },
  { href: 'gallery/', label: 'ギャラリー' },
  { href: 'about/', label: 'このサイトについて' },
  { href: 'profile/', label: 'プロフィール' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <SeoHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      type={type}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content="#f4eee4" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="読書 with Coco Reviews" href={`${base}rss.xml`} />
    <style>
      .container {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 clamp(16px, 2vw, 28px);
      }

      .skip-link {
        position: fixed;
        z-index: 100;
        inset: 8px auto auto 8px;
        padding: 10px 14px;
        border-radius: 999px;
        color: var(--color-nav);
        background: var(--color-text);
        transform: translateY(-160%);
        transition: transform 0.16s ease;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      header {
        position: sticky;
        top: 0;
        z-index: 40;
        padding-top: 12px;
        background: linear-gradient(to bottom, rgba(246, 242, 235, 0.88), rgba(246, 242, 235, 0));
        backdrop-filter: saturate(180%) blur(18px);
      }

      .nav-shell {
        min-width: 0;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: color-mix(in srgb, var(--color-nav) 92%, transparent);
        box-shadow: 0 10px 30px rgba(30, 24, 18, 0.05);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 46px;
        gap: 14px;
        padding: 0 10px 0 16px;
        min-width: 0;
      }

      .brand {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        max-width: 100%;
        min-width: 0;
        white-space: nowrap;
        color: var(--color-text);
      }

      .links {
        display: flex;
        gap: 4px;
        font-size: 0.88rem;
        min-width: 0;
        align-items: center;
      }

      .menu-button {
        display: none;
        min-width: 44px;
        min-height: 44px;
        padding: 0 13px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text);
        background: var(--color-nav-strong);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .link {
        padding: 8px 12px;
        border-radius: 999px;
        max-width: 100%;
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
        box-sizing: border-box;
        text-align: center;
        color: var(--color-muted);
        transition:
          background-color 0.2s ease,
          color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .link[aria-current='page'] {
        color: var(--color-text);
        background: var(--color-nav-strong);
        box-shadow: inset 0 0 0 1px rgba(75, 58, 38, 0.08);
      }

      .link:hover {
        background: rgba(255, 255, 255, 0.7);
        color: var(--color-text);
      }

      main {
        padding: 18px 0 44px;
      }

      footer {
        padding: 28px 0 40px;
        opacity: 0.72;
        font-size: 0.88rem;
        color: var(--color-muted);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-links {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }

      @media (max-width: 640px) {
        header {
          padding-top: 6px;
        }

        .nav-shell { border-radius: 24px; }

        .nav {
          min-height: 48px;
          flex-wrap: wrap;
          height: auto;
          padding: 3px 6px 3px 10px;
          gap: 8px;
        }

        .brand {
          flex: 0 0 auto;
          width: auto;
          text-align: left;
          font-size: 0.9rem;
          min-height: 44px;
          display: inline-flex;
          align-items: center;
          justify-content: flex-start;
        }

        .menu-button { display: inline-flex; align-items: center; justify-content: center; }

        .links {
          display: none;
          flex: 1 0 100%;
          width: 100%;
          padding: 6px 0 8px;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 4px;
          font-size: 0.82rem;
        }

        .links[data-open='true'] {
          display: grid;
        }

        .link {
          flex: 1 1 auto;
          min-height: 44px;
          display: flex;
          align-items: center;
          padding: 0 8px;
          box-sizing: border-box;
          white-space: nowrap;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
    <style is:global>
      :where(.ui-action) {
        max-width: 100%;
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
        box-sizing: border-box;
      }

      :where(.ui-action-group) {
        min-width: 0;
        flex-wrap: wrap;
      }

      :where(.ui-action-group > *) {
        min-width: 0;
      }

      @media (max-width: 640px) {
        :where(.ui-action-group--stack) {
          flex-direction: column;
        }

        :where(.ui-action-group--stack > .ui-action) {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header>
      <div class="container">
        <div class="nav-shell">
          <div class="nav">
            <a class="brand" href={base}>読書 with Coco</a>
            <button
              class="menu-button"
              type="button"
              aria-expanded="false"
              aria-controls="primary-navigation"
            >
              メニュー
            </button>
            <nav class="links" id="primary-navigation" aria-label="主要ナビゲーション">
              {navItems.map((i) => {
                const href = `${base}${i.href}`;
                const normalizedHref = href.endsWith('/') ? href : `${href}/`;
                const isCurrent = normalizedHref === currentPath;

                return (
                  <a class="link" href={href} aria-current={isCurrent ? 'page' : undefined}>
                    {i.label}
                  </a>
                );
              })}
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} 読書 with Coco</span>
        <nav class="footer-links" aria-label="フッターナビゲーション">
          <a href={`${base}reviews/`}>レビュー</a>
          <a href={`${base}about/`}>運営方針</a>
          <a href={`${base}profile/`}>プロフィール</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const button = document.querySelector('.menu-button');
        const nav = document.querySelector('#primary-navigation');
        if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

        const close = (restoreFocus = false) => {
          button.setAttribute('aria-expanded', 'false');
          nav.dataset.open = 'false';
          if (restoreFocus) button.focus();
        };

        button.addEventListener('click', () => {
          const willOpen = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(willOpen));
          nav.dataset.open = String(willOpen);
          if (willOpen) nav.querySelector('a')?.focus();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
            close(true);
          }
        });

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Node && !button.contains(target) && !nav.contains(target)) close();
        });

        window.matchMedia('(min-width: 641px)').addEventListener('change', (event) => {
          if (event.matches) close();
        });
      })();
    </script>
  </body>
</html>
