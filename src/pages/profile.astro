---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getResponsiveMedia, getSocialImage } from '../lib/media';
import { getPublishedGallery, hasDetailContent } from '../utils/gallery';
import { getPublishedReviews } from '../utils/reviews';
import '../styles/about-profile.css';

const entry = await getEntry('profile', 'profile');
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
const base = import.meta.env.BASE_URL;
const avatar = entry?.data.avatar ?? '/uploads/profile.png';
const gallery = (await getPublishedGallery()).filter(hasDetailContent);
const scene = gallery.find((item) => item.slug === 'business-seisei-ai-de-sekai-wa-kou-kawaru-imai-shota' && item.data.visualOrigin === 'ai-generated')
  ?? gallery.find((item) => item.data.visualOrigin === 'ai-generated')
  ?? gallery[0];
const sceneImage = scene ? getResponsiveMedia(scene.data.image, base, 'card') : null;
const reviews = await getPublishedReviews();
const writerReview = reviews.find((item) => item.slug === 'guzen-ha-donoyouni-anata-wo-tsukurunoka');
const updatedAt = entry?.data.updatedAt?.toISOString().slice(0, 10);
---

<Layout title={`${entry?.data.title ?? 'ココちゃんと書き手'} | 読書with Coco`} description={entry?.data.description}
  image={getSocialImage(avatar, base)} imageAlt="読書with Cocoの案内役、ココちゃん">
  <div class="guide-page profile-world">
    <section class="guide-hero profile-hero" aria-labelledby="profile-title">
      <div class="hero-copy">
        <p class="section-label">ココちゃんと書き手</p>
        <p class="hero-brand">読書with Coco</p>
        <h1 id="profile-title">本の世界を、一緒に。</h1>
        <p class="hero-lead">{entry?.data.introduction?.trim() || 'ココちゃんと、本から生まれた言葉や景色を届ける書き手の紹介です。'}</p>
        <div class="hero-actions ui-action-group">
          <a class="hero-link hero-link-primary ui-action" href={`${base}reviews/`}>レビューを見る</a>
          <a class="hero-link hero-link-secondary ui-action" href={`${base}gallery/`}>ギャラリーを見る</a>
        </div>
        <a class="guide-text-link" href="#writer">書き手について ↓</a>
      </div>
      <figure class="hero-visual">
        <img src={getResponsiveMedia(avatar, base, 'hero').src} alt="読書with Cocoの案内役、ココちゃん" width="720" height="720" loading="eager" decoding="async" />
      </figure>
    </section>

    <section class="guide-section character-room" aria-labelledby="coco-title">
      <p class="section-label">ココちゃんのこと</p>
      <h2 id="coco-title">おてんばで、ちょっぴり慎重。</h2>
      <dl class="guide-lines coco-facts">
        {(entry?.data.profileItems ?? []).map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      </dl>
      <div class="coco-everyday">
        <div><h3>すきなこと</h3><p>{entry?.data.favoriteItems?.join('、')}。</p></div>
        <div><h3>にがてなこと</h3><p>{entry?.data.sensitiveItems?.join('、')}。</p></div>
      </div>
      <p>{entry?.data.roleText}</p>
    </section>

    {scene && sceneImage && <section class="guide-section guide-scene" aria-labelledby="scene-title">
      <a class="guide-scene-image" href={`${base}gallery/${scene.slug}/`} aria-label={`『${scene.data.title}』の景色を見る`}>
        <img src={sceneImage.src} alt={`『${scene.data.title}』から生まれた、ココちゃんのいる読後の景色`} width="520" height="640" loading="lazy" decoding="async" />
      </a>
      <div>
        <p class="section-label">本から生まれたココちゃんの旅</p>
        <h2 id="scene-title">言葉の先には、こんな景色も。</h2>
        <p>『{scene.data.title}』</p>
        <p>{scene.data.description || scene.data.note}</p>
        <p class="guide-note">{scene.data.visualOrigin === 'ai-generated' ? '本から着想したAI制作の読後ビジュアルです。公式書影ではありません。' : '本から着想した読後の景色です。'}</p>
        <a class="guide-text-link" href={`${base}gallery/${scene.slug}/`}>この景色を眺める →</a>
      </div>
    </section>}

    <section class="guide-section" id="writer" aria-label="書き手について">
      <p class="section-label">書き手について</p>
      <div class="guide-copy">{Content && <Content />}</div>
      {writerReview && <p><a class="guide-text-link" href={`${base}reviews/${writerReview.slug}/`}>書き手の視点に触れる：『{writerReview.data.bookTitle ?? writerReview.data.title}』→</a></p>}
    </section>

    <section class="guide-closing" aria-labelledby="profile-next">
      <h2 id="profile-next">{entry?.data.closingQuote ?? 'いっしょに、次の一冊の景色を見にいこう。'}</h2>
      <a class="hero-link hero-link-primary ui-action" href={`${base}reviews/`}>レビューを見る</a>
      <a class="guide-text-link" href={`${base}about/`}>このサイトについて →</a>
    </section>
    {updatedAt && <p class="guide-updated">更新: <time datetime={updatedAt}>{updatedAt}</time></p>}
  </div>
</Layout>
