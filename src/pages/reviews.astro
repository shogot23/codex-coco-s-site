---
import Layout from "../layouts/Layout.astro";
import ReviewExplorer from "../components/reviews/ReviewExplorer.astro";
import { buildCollectionJsonLd, buildJsonLdGraph } from "../lib/seo";
import { getResponsiveMedia } from "../lib/media";
import { buildReviewGalleryMap, getPublishedGallery } from "../utils/gallery";
import { getPublishedReviews } from "../utils/reviews";

const reviews = await getPublishedReviews();
const sortedReviews = [...reviews].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.slug.localeCompare(b.slug)
);
const galleryEntries = await getPublishedGallery();
const reviewGalleryMap = buildReviewGalleryMap(galleryEntries);
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;

const withBase = (assetPath: string) => {
  if (!assetPath) return baseWithSlash;
  return getResponsiveMedia(assetPath, baseWithSlash, "card").src;
};

const formatDate = (value: Date) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(value);

const stripMarkdown = (value: string) =>
  value
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[*_`>#-]/g, "")
    .replace(/\n{3,}/g, "\n\n")
    .trim();

const clampText = (text: string, maxLength: number): string => {
  const normalized = stripMarkdown(text).replace(/\s+/g, " ").trim();
  if (!normalized) return "";
  if (normalized.length <= maxLength) return normalized;
  return `${normalized.slice(0, maxLength).trimEnd()}…`;
};

const reviewCards = sortedReviews.map((review) => {
  const href = `${baseWithSlash}reviews/${review.slug}/`;
  const quoteSource = review.data.excerpt ?? review.body ?? review.data.description ?? "";
  const galleryImage = reviewGalleryMap.get(review.slug)?.data.image;
  const thumbnail = galleryImage ?? review.data.cover ?? review.data.infographic;
  const supplementalTitle =
    review.data.bookTitle && review.data.bookTitle !== review.data.title
      ? review.data.bookTitle
      : null;

  return {
    slug: review.slug,
    title: review.data.title,
    supplementalTitle,
    author: review.data.author,
    date: review.data.date,
    dateLabel: formatDate(review.data.date),
    href,
    thumbnail,
    quote: clampText(quoteSource, 88),
    readerWorry: review.data.readerWorry,
    smallStep: review.data.smallStep,
    tags: review.data.tags ?? [],
  };
});

const featuredReview = reviewCards[0] ?? null;
const remainingReviews = reviewCards.slice(1);
const galleryUrl = `${baseWithSlash}gallery/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site!).toString();
const reviewsJsonLd = buildJsonLdGraph([
  buildCollectionJsonLd(
    canonicalUrl,
    "レビュー | 読書 with Coco",
    "暮らしのモヤモヤから、問い・見方の変化・今日の一歩を持ち帰るレビュー一覧。",
    reviewCards.map((review) => ({
      name: review.title,
      url: new URL(review.href, Astro.site!).toString(),
    }))
  ),
]);
const explorerItems = remainingReviews.map((review) => ({
  slug: review.slug,
  title: review.title,
  author: review.author,
  href: review.href,
  image: review.thumbnail ? withBase(review.thumbnail) : undefined,
  readerWorry: review.readerWorry,
  tags: review.tags,
}));
---

<Layout
  title="レビュー | 読書 with Coco"
  description="暮らしのモヤモヤから、問い・見方の変化・今日の一歩を持ち帰る、読書 with Coco のレビュー一覧。"
  jsonLd={reviewsJsonLd}
>
  <div class="reviews-story">
    <section class="hero" aria-labelledby="reviews-heading">
      <p class="hero-kicker">読書 with Coco / Reviews</p>
      <h1 id="reviews-heading">いまの気持ちに、静かな一冊を。</h1>
      <p class="hero-lead">難しい本の言葉を、暮らしで使える小さな問いと一歩へ。今の自分に近い一冊から、ゆっくりどうぞ。</p>
      <div class="hero-actions ui-action-group ui-action-group--stack">
        <a class="hero-button hero-button-primary ui-action" href={featuredReview ? featuredReview.href : "#review-stream"}>
          {featuredReview ? "最新レビューを読む" : "本棚を見る"}
        </a>
        {remainingReviews.length > 0 && <a class="hero-button hero-button-secondary ui-action" href="#review-stream">本棚から選ぶ</a>}
      </div>
    </section>

    {featuredReview ? (
      <section class="featured-section" aria-labelledby="featured-review-heading">
        <div class="section-header">
          <div>
            <p class="section-label">Latest Review</p>
            <h2 id="featured-review-heading">まずは、この一冊から。</h2>
          </div>
          <p class="section-copy">読む理由がまだはっきりしない日にも、残る言葉から本へ入れます。</p>
        </div>

        <article class="featured-review">
          <a class="featured-media" href={featuredReview.href} aria-label={`${featuredReview.title}のレビューを読む`}>
            {featuredReview.thumbnail ? (
              <img src={withBase(featuredReview.thumbnail)} alt={`${featuredReview.title}のレビューイメージ`} loading="eager" fetchpriority="high" decoding="async" width="520" height="640" />
            ) : (
              <span class="media-fallback" aria-hidden="true">Review</span>
            )}
          </a>
          <div class="featured-body">
            <p class="featured-eyebrow">Latest Arrival</p>
            <h3 class="featured-title"><a href={featuredReview.href}>{featuredReview.title}</a></h3>
            {featuredReview.supplementalTitle && <p class="featured-book-title">{featuredReview.supplementalTitle}</p>}
            <p class="featured-meta">
              {featuredReview.author && <span>著者: {featuredReview.author}</span>}
              <time datetime={featuredReview.date.toISOString()}>{featuredReview.dateLabel}</time>
            </p>
            {featuredReview.quote && (
              <div class="featured-quote">
                <p>この作品に残った言葉</p>
                <blockquote>{featuredReview.quote}</blockquote>
              </div>
            )}
            {featuredReview.smallStep && (
              <div class="featured-step">
                <p>今日の小さな一歩</p>
                <span>{featuredReview.smallStep}</span>
              </div>
            )}
            <a class="hero-button hero-button-primary ui-action" href={featuredReview.href}>このレビューを読む</a>
          </div>
        </article>
      </section>
    ) : (
      <section class="empty-state" aria-labelledby="empty-heading">
        <p class="section-label">Reviews</p>
        <h2 id="empty-heading">レビューを準備中です。</h2>
        <p>公開されたら、ここが次に読みたくなる入口になります。</p>
      </section>
    )}

    {remainingReviews.length > 0 && (
      <section class="stream-section" id="review-stream" aria-labelledby="review-stream-heading">
        <div class="section-header">
          <div>
            <p class="section-label">Bookshelf</p>
            <h2 id="review-stream-heading">本棚から、次の一冊へ。</h2>
          </div>
          <p class="section-copy">テーマや今のモヤモヤから、気になる言葉を選んでください。</p>
        </div>
        <ReviewExplorer items={explorerItems} initialLimit={4} />
      </section>
    )}

    <section class="afterword" aria-labelledby="afterword-heading">
      <div>
        <p class="section-label">After Reading</p>
        <h2 id="afterword-heading">言葉の次は、ココちゃんと景色へ。</h2>
      </div>
      <p>レビューで輪郭をつかんだあと、同じ一冊の空気をもう少し別の入口からたどりたいときはギャラリーへ。</p>
      <a class="hero-button hero-button-secondary ui-action" href={galleryUrl}>ギャラリーを見る</a>
    </section>
  </div>
</Layout>

<style>
  .reviews-story { display: grid; grid-template-columns: minmax(0,1fr); gap: clamp(2.2rem,4vw,3.8rem); min-width: 0; padding: clamp(.5rem,1vw,1rem) 0 clamp(2rem,4vw,3rem); }
  .reviews-story > * { min-width: 0; }
  .hero, .featured-review, .afterword, .empty-state { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: rgba(255,250,243,.82); }
  .hero { display: grid; justify-items: start; gap: .85rem; padding: clamp(1.5rem,4vw,3rem); background: radial-gradient(circle at top right,rgba(235,224,209,.65),transparent 34%),rgba(255,250,243,.92); box-shadow: var(--shadow-soft); }
  .hero-kicker, .section-label, .featured-eyebrow, .featured-quote > p, .featured-step > p { margin: 0; color: var(--color-accent); font-size: var(--text-meta); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .hero h1 { max-width: 13ch; margin: 0; font-size: clamp(2.2rem,5vw,4rem); line-height: 1.08; }
  .hero-lead, .section-copy, .afterword p, .empty-state p { max-width: var(--measure-copy); margin: 0; color: color-mix(in srgb,var(--color-text) 82%,transparent); line-height: var(--leading-copy); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .35rem; }
  .hero-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: .85rem 1.35rem; border-radius: var(--radius-pill); font-weight: 700; }
  .hero-button-primary { background: linear-gradient(180deg,rgba(50,45,41,.96),rgba(29,27,25,.96)); color: #fffdf9; box-shadow: 0 18px 34px rgba(26,22,20,.16); }
  .hero-button-secondary { border: 1px solid var(--color-border); background: rgba(255,255,255,.78); color: var(--color-text); }
  .hero-button:hover, .featured-media:hover { transform: translateY(-2px); }
  .section-header { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,25rem); gap: .75rem 2rem; align-items: end; margin-bottom: 1.2rem; }
  .section-header h2, .afterword h2, .empty-state h2 { margin: .3rem 0 0; font-size: clamp(1.7rem,3vw,2.45rem); line-height: 1.18; }
  .featured-review { display: grid; grid-template-columns: minmax(15rem,.72fr) minmax(0,1fr); gap: clamp(1.25rem,3vw,2.5rem); padding: clamp(1rem,3vw,2rem); box-shadow: var(--shadow-soft); }
  .featured-media { display: block; overflow: hidden; min-width: 0; aspect-ratio: 4 / 5; border-radius: var(--radius-md); background: var(--color-surface-soft); transition: transform .2s ease; }
  .featured-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .media-fallback { display: grid; min-height: 100%; place-items: center; color: var(--color-muted); font-family: var(--font-headline); }
  .featured-body { display: grid; align-content: center; gap: .85rem; min-width: 0; }
  .featured-title { margin: 0; font-size: clamp(1.65rem,3vw,2.35rem); line-height: 1.22; }
  .featured-book-title, .featured-meta { margin: 0; color: var(--color-muted); }
  .featured-meta { display: flex; flex-wrap: wrap; gap: .4rem .9rem; font-size: .92rem; }
  .featured-quote, .featured-step { display: grid; gap: .35rem; }
  blockquote { margin: 0; padding: .8rem .95rem; border-left: 3px solid color-mix(in srgb,var(--color-accent) 55%,transparent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: rgba(243,223,180,.16); font-family: var(--font-headline); line-height: 1.65; }
  .featured-step span { color: color-mix(in srgb,var(--color-text) 82%,transparent); line-height: 1.65; }
  .stream-section { min-width: 0; }
  .afterword, .empty-state { display: grid; justify-items: start; gap: .85rem; max-width: 44rem; margin-inline: auto; padding: clamp(1.35rem,3vw,2rem); }
  @media (max-width: 760px) { .section-header, .featured-review { grid-template-columns: minmax(0,1fr); } .featured-media { max-width: 27rem; } }
  @media (max-width: 560px) { .reviews-story { gap: 1.8rem; } .hero, .featured-review, .afterword, .empty-state { border-radius: var(--radius-md); } .hero { padding: 1.25rem; } .hero h1 { font-size: 2.15rem; } .hero-actions { width: 100%; } .hero-actions .hero-button, .featured-body > .hero-button { width: 100%; } .featured-media { max-width: 100%; } .featured-review { padding: .9rem; } }
</style>
