---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getResponsiveMedia, getSocialImage } from '../lib/media';
import { getPublishedReviews } from '../utils/reviews';
import { getVisibleWorks } from '../utils/works';
import { buildReviewGalleryMap, getPublishedGallery, hasDetailContent } from '../utils/gallery';
import '../styles/about-profile.css';

const entry = await getEntry('about', 'about');
const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
const base = import.meta.env.BASE_URL;
const reviews = await getPublishedReviews();
const example = reviews.find((review) => review.slug === 'watashi-ga-machigatteru-kamosirenai');
const gallery = buildReviewGalleryMap((await getPublishedGallery()).filter(hasDetailContent));
const exampleGallery = example ? gallery.get(example.slug) : null;
const exampleWork = example ? (await getVisibleWorks()).find((work) => work.data.published && [example.id, example.slug].includes(work.data.relatedReview?.id ?? '')) : null;
const hero = getResponsiveMedia('/uploads/about-hero.png', base, 'hero');
const updatedAt = entry?.data.updatedAt?.toISOString().slice(0, 10);
---

<Layout title={`${entry?.data.title ?? 'このサイトについて'} | 読書with Coco`}
  description={entry?.data.description} image={getSocialImage('/uploads/about-hero.png', base)}
  imageAlt="本に囲まれた読書with Cocoの案内役、ココちゃん">
  <div class="guide-page about-world">
    <section class="guide-hero about-hero" aria-labelledby="about-title">
      <div class="hero-copy">
        <p class="section-label">このサイトについて</p>
        <p class="hero-brand">読書with Coco</p>
        <h1 id="about-title">本から、今日の自分へ。</h1>
        <p class="hero-lead">忙しい日や、気がかりがある日に。ココちゃんと本の言葉や景色をたどり、ひとつの問いと、今選べる小さな一歩を持ち帰る場所です。</p>
        <div class="hero-actions ui-action-group">
          <a class="hero-link hero-link-primary ui-action" href={`${base}reviews/`}>レビューを見る</a>
          <a class="hero-link hero-link-secondary ui-action" href={`${base}gallery/`}>ギャラリーを見る</a>
        </div>
        <a class="guide-text-link" href="#今の自分に合う入口から">楽しみ方を選ぶ ↓</a>
      </div>
      <figure class="hero-visual">
        <img src={hero.src} alt="本に囲まれたココちゃん" width="960" height="960" loading="eager" decoding="async" />
      </figure>
    </section>

    <section class="guide-section" aria-labelledby="takeaway-title">
      <p class="section-label">本と暮らしのあいだ</p>
      <h2 id="takeaway-title">ひとつの問いが、暮らしにつながる。</h2>
      <p>小説や漫画、エッセイ、人文書まで。本をきっかけに、自分や周りの見え方を少し確かめ直します。</p>
      {example && <div class="guide-example">
        <p class="guide-example-book">たとえば、『{example.data.bookTitle ?? example.data.title}』から。</p>
        <dl class="guide-lines">
          <div><dt>気がかり</dt><dd>{example.data.readerWorry}</dd></div>
          <div><dt>本からの問い</dt><dd>{example.data.bookQuestion}</dd></div>
          <div><dt>見方の変化</dt><dd>{example.data.perspectiveShift}</dd></div>
          <div><dt>今選べる一歩</dt><dd>{example.data.smallStep}</dd></div>
        </dl>
        <div class="guide-inline-links">
          <a class="guide-text-link" href={`${base}reviews/${example.slug}/`}>このレビューを読む →</a>
          {exampleGallery && <a class="guide-text-link" href={`${base}gallery/${exampleGallery.slug}/`}>同じ本の景色へ →</a>}
          {exampleWork && <a class="guide-text-link" href={`${base}works/${exampleWork.slug}/`}>この本から生まれたワークへ →</a>}
        </div>
      </div>}
    </section>

    <div class="guide-copy guide-section">{Content && <Content />}</div>

    <section class="guide-closing" aria-labelledby="about-next">
      <h2 id="about-next">今日は、気になる一冊から。</h2>
      <p>問いがひとつ残れば、それだけでも。続きは、また読みたくなった日に。</p>
      <a class="hero-link hero-link-primary ui-action" href={`${base}reviews/`}>レビューを見る</a>
    </section>
    {updatedAt && <p class="guide-updated">更新: <time datetime={updatedAt}>{updatedAt}</time></p>}
  </div>
</Layout>
