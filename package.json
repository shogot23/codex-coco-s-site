{
  "name": "major-metal",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run media:generate",
    "build": "astro build",
    "postbuild": "npm run media:prune && npm run check:dist",
    "build:cf": "ASTRO_BASE=/ npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:frontend": "npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "media:generate": "node scripts/generate-image-derivatives.mjs",
    "media:prune": "node scripts/prune-dist-originals.mjs",
    "check:links": "node scripts/check-dist-links.mjs",
    "check:integrity": "node scripts/check-dist-integrity.mjs --require-cms",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:video-toolchain": "node scripts/check-video-toolchain.mjs",
    "video:generate": "node scripts/generate-video-assets.mjs",
    "check:content": "node scripts/audit-review-editorial-fields.mjs src/content/reviews",
    "check:dist": "npm run check:links && npm run check:integrity && npm run check:performance",
    "test:content-tools": "node --test scripts/migrate-review-editorial-fields.test.mjs scripts/audit-review-editorial-fields.test.mjs",
    "gallery:import": "node scripts/gallery-import.ts",
    "gallery:pipeline": "node scripts/gallery-pipeline.mjs",
    "gallery:ocr": "node scripts/ocr-gallery-images.ts",
    "gallery:apply-corrections": "node scripts/apply-gallery-corrections.ts",
    "gallery:generate": "node scripts/generate-gallery-md.ts",
    "gallery:sync": "npm run gallery:ocr && npm run gallery:apply-corrections && npm run gallery:generate",
    "test:gallery-generate": "node --test scripts/generate-gallery-md.test.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.17.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.35.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.3.3",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "ffmpeg-static": "^5.2.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
